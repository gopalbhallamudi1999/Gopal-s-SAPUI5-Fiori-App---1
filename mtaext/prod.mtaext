    parameters:
      service-name: comgopaldemofioriapp1-destination-service-prod

  - name: comgopaldemofioriapp1-uaa
    parameters:
      service-name: comgopaldemofioriapp1-xsuaa-service-prod
      config:
        xsappname: comgopaldemofioriapp1-prod

  - name: comgopaldemofioriapp1-repo-host
    parameters:
      service-name: comgopaldemofioriapp1-html5-service-prod

      
modules:
  - name: comgopaldemofioriapp1-destination-content
    parameters:
      content:
        instance:
          destinations:
            - Name: comgopaldemofioriapp1_html_repo_host
              ServiceInstanceName: comgopaldemofioriapp1-html5-service-prod
              ServiceKeyName: comgopaldemofioriapp1-repo-host-key
              sap.cloud.service: comgopaldemofioriapp1

            - Authentication: OAuth2UserTokenExchange
              Name: comgopaldemofioriapp1_uaa
              ServiceInstanceName: comgopaldemofioriapp1-xsuaa-service-prod
              ServiceKeyName: comgopaldemofioriapp1-uaa-key
              sap.cloud.service: comgopaldemofioriapp1